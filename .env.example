# Paperclip Railway template environment variables
# Copy this file to .env for local reference only.
# In Railway template composer, set these in service variables.

# Required
# Primary Postgres connection string from Railway managed postgres service.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Authentication/session signing secret for Better Auth (generated, keep hidden).
BETTER_AUTH_SECRET=${{secret(64, "abcdef0123456789")}}
# Bind host for container runtime.
HOST=0.0.0.0
# Internal app port exposed by container.
PORT=3100
# Enables serving Paperclip UI from the app service.
SERVE_UI=true
# Persistent filesystem root for Paperclip app state/config.
PAPERCLIP_HOME=/paperclip
# Deployment mode; authenticated requires login/auth flow.
PAPERCLIP_DEPLOYMENT_MODE=authenticated
# Exposure model for deployment; private is recommended default.
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# Public base URL used by Paperclip for callbacks/links.
PAPERCLIP_PUBLIC_URL=https://${{Paperclip.RAILWAY_PUBLIC_DOMAIN}}
# Canonical auth callback/redirect base URL for Better Auth.
BETTER_AUTH_BASE_URL=https://${{Paperclip.RAILWAY_PUBLIC_DOMAIN}}

# Optional
# PAPERCLIP_REF=v2026.722.0

# Claude Code agents — subscription auth (recommended, no Anthropic API key).
# Mint with `claude setup-token` on a machine already signed in to Claude Code,
# or inside this container over `railway ssh`, and paste the token here.
# Leave ANTHROPIC_API_KEY unset when using this: an API key overrides
# subscription credentials, and Paperclip rejects the two together
# (CLAUDE_OAUTH_CREDENTIAL_CONFLICT).
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative Claude auth — API billing instead of your subscription.
# Mutually exclusive with CLAUDE_CODE_OAUTH_TOKEN.
# ANTHROPIC_API_KEY=

# OpenAI API key for OpenAI-backed agent/provider features (Codex + OpenCode providers).
# OPENAI_API_KEY=

# Optional: Google AI / Gemini CLI-backed agents.
# GEMINI_API_KEY=

# Only relevant if you later add a sandbox provider plugin and use Paperclip's
# own in-app Claude sign-in. Tells the transport guard that Railway terminates
# TLS at its edge, so it stops warning about a connection that is HTTPS to the
# user. Advisory only — it never blocks a login.
# CLAUDE_LOGIN_EDGE_TLS_TERMINATED=true
